@using freelanceMarketplace.Models

@{
    ViewData["Title"] = "Dashboard";
}

<style>
    /* ==============================
       Dashboard Page
       ============================== */

    .dashboard-page {
        background-color: #f3f4f6;
        min-height: calc(100vh - 56px);
        padding: 40px 0 60px 0;
    }

    .dashboard-container {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 20px;
    }

    /* Header */

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 32px;
    }

    .dashboard-title {
        margin: 0;
        font-size: 32px;
        font-weight: 600;
        color: #171717;
    }

    .dashboard-subtitle {
        margin-top: 8px;
        margin-bottom: 0;
        color: #6b7280;
        font-size: 15px;
    }

    .view-gigs-button {
        background-color: #252525;
        color: white;
        border: none;
        padding: 11px 22px;
        border-radius: 7px;
        text-decoration: none;
        font-size: 14px;
        transition: 0.2s ease;
    }

    .view-gigs-button:hover {
        background-color: #111111;
        color: white;
    }


    /* Statistics */

    .statistics-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 34px;
    }

    .stat-card {
        min-height: 170px;
        padding: 25px;
        border-radius: 10px;
        border: 1px solid #d8d8d8;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .stat-card h5 {
        margin: 0 0 15px 0;
        font-size: 16px;
        font-weight: 600;
    }

    .stat-number {
        font-size: 42px;
        line-height: 1;
        font-weight: 400;
        margin-bottom: 12px;
    }

    .stat-description {
        margin: 0;
        font-size: 14px;
    }


    /* Different grayscale cards */

    .card-dark {
        background-color: #252525;
        color: #ffffff;
        border-color: #252525;
    }

    .card-dark .stat-description {
        color: #cfcfcf;
    }

    .card-charcoal {
        background-color: #3b3b3b;
        color: #ffffff;
        border-color: #3b3b3b;
    }

    .card-charcoal .stat-description {
        color: #d6d6d6;
    }

    .card-gray {
        background-color: #e4e4e4;
        color: #202020;
    }

    .card-gray .stat-description {
        color: #666666;
    }

    .card-light {
        background-color: #ffffff;
        color: #171717;
    }

    .card-light .stat-description {
        color: #737373;
    }

    .card-soft-dark {
        background-color: #555555;
        color: #ffffff;
        border-color: #555555;
    }

    .card-soft-dark .stat-description {
        color: #dddddd;
    }

    .card-off-white {
        background-color: #eeeeee;
        color: #202020;
    }

    .card-off-white .stat-description {
        color: #666666;
    }


    /* Recent Orders */

    .recent-orders-section {
        background-color: #ffffff;
        border: 1px solid #d8d8d8;
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .recent-orders-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 22px 25px;
        border-bottom: 1px solid #dddddd;
    }

    .recent-orders-header h4 {
        margin: 0;
        font-size: 20px;
        font-weight: 600;
        color: #171717;
    }

    .view-orders-link {
        color: #333333;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
    }

    .view-orders-link:hover {
        color: #000000;
        text-decoration: underline;
    }


    /* Table */

    .orders-table {
        width: 100%;
        border-collapse: collapse;
    }

    .orders-table th {
        background-color: #292929;
        color: #ffffff;
        padding: 14px 18px;
        text-align: left;
        font-size: 13px;
        font-weight: 600;
    }

    .orders-table td {
        padding: 15px 18px;
        border-bottom: 1px solid #e1e1e1;
        font-size: 14px;
        color: #333333;
    }

    .orders-table tr:last-child td {
        border-bottom: none;
    }

    .orders-table tbody tr:hover {
        background-color: #f5f5f5;
    }


    /* Status */

    .status-badge {
        display: inline-block;
        padding: 5px 11px;
        border-radius: 5px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-pending {
        background-color: #e5e5e5;
        color: #333333;
    }

    .status-completed {
        background-color: #333333;
        color: #ffffff;
    }

    .status-cancelled {
        background-color: #bdbdbd;
        color: #202020;
    }


    /* Empty state */

    .empty-orders {
        text-align: center;
        padding: 40px 20px;
        color: #777777;
    }


    /* Responsive */

    @@media (max-width: 900px) {

        .statistics-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .dashboard-header {
            align-items: flex-start;
            gap: 20px;
        }
    }


    @@media (max-width: 600px) {

        .dashboard-page {
            padding-top: 25px;
        }

        .dashboard-header {
            flex-direction: column;
        }

        .dashboard-title {
            font-size: 27px;
        }

        .statistics-grid {
            grid-template-columns: 1fr;
        }

        .recent-orders-section {
            overflow-x: auto;
        }

        .orders-table {
            min-width: 650px;
        }
    }
</style>


<div class="dashboard-page">

    <div class="dashboard-container">

        <!-- ==============================
             Dashboard Header
             ============================== -->

        <div class="dashboard-header">

            <div>
                <h1 class="dashboard-title">
                    Dashboard
                </h1>

                <p class="dashboard-subtitle">
                    Overview of your Freelance Marketplace
                </p>
            </div>

            <a href="/Gigs/List"
               class="view-gigs-button">
                View Gigs
            </a>

        </div>


        <!-- ==============================
             Statistics Cards
             ============================== -->

        <div class="statistics-grid">

            <!-- Total Users -->

            <div class="stat-card card-dark">

                <h5>
                    Total Users
                </h5>

                <div class="stat-number">
                    @ViewBag.TotalUsers
                </div>

                <p class="stat-description">
                    Registered users
                </p>

            </div>


            <!-- Total Gigs -->

            <div class="stat-card card-light">

                <h5>
                    Total Gigs
                </h5>

                <div class="stat-number">
                    @ViewBag.TotalGigs
                </div>

                <p class="stat-description">
                    Available services
                </p>

            </div>


            <!-- Total Orders -->

            <div class="stat-card card-charcoal">

                <h5>
                    Total Orders
                </h5>

                <div class="stat-number">
                    @ViewBag.TotalOrders
                </div>

                <p class="stat-description">
                    Orders placed
                </p>

            </div>


            <!-- Pending Orders -->

            <div class="stat-card card-gray">

                <h5>
                    Pending Orders
                </h5>

                <div class="stat-number">
                    @ViewBag.PendingOrders
                </div>

                <p class="stat-description">
                    Waiting for completion
                </p>

            </div>


            <!-- Completed Orders -->

            <div class="stat-card card-soft-dark">

                <h5>
                    Completed Orders
                </h5>

                <div class="stat-number">
                    @ViewBag.CompletedOrders
                </div>

                <p class="stat-description">
                    Successfully completed
                </p>

            </div>


            <!-- Cancelled Orders -->

            <div class="stat-card card-off-white">

                <h5>
                    Cancelled Orders
                </h5>

                <div class="stat-number">
                    @ViewBag.CancelledOrders
                </div>

                <p class="stat-description">
                    Cancelled orders
                </p>

            </div>

        </div>


        <!-- ==============================
             Recent Orders
             ============================== -->

        <div class="recent-orders-section">

            <div class="recent-orders-header">

                <h4>
                    Recent Orders
                </h4>

                <a href="/Orders/List"
                   class="view-orders-link">
                    View all orders
                </a>

            </div>


            @if (ViewBag.RecentOrders != null &&
                 ViewBag.RecentOrders.Count > 0)
            {
                <table class="orders-table">

                    <thead>

                        <tr>
                            <th>
                                Order ID
                            </th>

                            <th>
                                Gig
                            </th>

                            <th>
                                Buyer
                            </th>

                            <th>
                                Status
                            </th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var order in ViewBag.RecentOrders)
                        {
                            <tr>

                                <td>
                                    #@order.Id
                                </td>

                                <td>
                                    @(order.Gig != null
                                        ? order.Gig.Title
                                        : "Unknown Gig")
                                </td>

                                <td>
                                    @(order.Buyer != null
                                        ? order.Buyer.Name
                                        : "Unknown Buyer")
                                </td>

                                <td>

                                    @if (order.Status == "Pending")
                                    {
                                        <span class="status-badge status-pending">
                                            Pending
                                        </span>
                                    }
                                    else if (order.Status == "Completed")
                                    {
                                        <span class="status-badge status-completed">
                                            Completed
                                        </span>
                                    }
                                    else if (order.Status == "Cancelled")
                                    {
                                        <span class="status-badge status-cancelled">
                                            Cancelled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-pending">
                                            @order.Status
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }
            else
            {
                <div class="empty-orders">
                    No orders have been placed yet.
                </div>
            }

        </div>

    </div>

</div>