<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Freelance Marketplace</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">

            <a class="navbar-brand" href="/">
                Freelance Marketplace
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav">

                    <li class="nav-item">
                        <a class="nav-link" href="/Dashboard">
                            Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Gigs/List">
                            All Gigs
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Gigs/Create">
                            Create Gig
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Orders/List">
                            Orders
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Orders/MyOrders">
                            My Orders
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Users/List">
                            Users
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Users/Logout">
                            Logout
                        </a>
                    </li>

                </ul>

            </div>

        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>