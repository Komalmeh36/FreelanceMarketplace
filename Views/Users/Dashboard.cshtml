@{
    ViewData["Title"] = "My Dashboard";
}

<style>
    body {
        background-color: #f3f3f3;
    }

    .user-dashboard {
        padding: 50px 0 60px 0;
    }

    .welcome-card {
        background-color: white;
        border: 1px solid #ddd;
        border-radius: 10px;
        padding: 35px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.09);
        max-width: 850px;
        margin: 0 auto;
    }

    .dashboard-header {
        margin-bottom: 25px;
    }

    .dashboard-header h2 {
        margin: 0;
        font-weight: 600;
        color: #222;
    }

    .dashboard-header p {
        margin: 7px 0 0 0;
        color: #666;
    }

    .user-info {
        background-color: #f5f5f5;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 25px;
    }

    .user-info h4 {
        margin: 0 0 8px 0;
        color: #222;
        font-weight: 600;
    }

    .user-role {
        margin: 0;
        color: #555;
    }

    .user-role strong {
        color: #222;
    }

    .dashboard-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .dashboard-btn {
        border-radius: 6px;
        padding: 10px 18px;
        text-decoration: none;
        font-weight: 500;
        display: inline-block;
    }

    .dark-btn {
        background-color: #333;
        border: 1px solid #333;
        color: white;
    }

    .dark-btn:hover {
        background-color: #222;
        border-color: #222;
        color: white;
    }

    .light-btn {
        background-color: #e5e5e5;
        border: 1px solid #d0d0d0;
        color: #222;
    }

    .light-btn:hover {
        background-color: #d5d5d5;
        border-color: #c5c5c5;
        color: #111;
    }

    .logout-btn {
        background-color: #444;
        border: 1px solid #444;
        color: white;
    }

    .logout-btn:hover {
        background-color: #292929;
        border-color: #292929;
        color: white;
    }
</style>


<div class="user-dashboard">

    <div class="welcome-card">

        <!-- Header -->

        <div class="dashboard-header">

            <h2>
                Welcome to your Dashboard
            </h2>

            <p>
                Manage your freelance marketplace account
            </p>

        </div>


        <!-- User Information -->

        <div class="user-info">

            <h4>
                Hello @ViewBag.UserName
            </h4>

            <p class="user-role">
                Role:
                <strong>@ViewBag.UserRole</strong>
            </p>

        </div>


        <!-- Actions -->

        <div class="dashboard-actions">

            <a href="/Gigs/List"
               class="dashboard-btn dark-btn">
                View Gigs
            </a>

            <a href="/Users/List"
               class="dashboard-btn light-btn">
                View Users
            </a>

            <a href="/Users/Logout"
               class="dashboard-btn logout-btn">
                Logout
            </a>

        </div>

    </div>

</div>